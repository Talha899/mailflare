# Copy to `.env` and fill in values. Paste the same file into Coolify.
# Do not set DATA_DIR — the image uses /mailflare-data to match the compose volume.

SAAS_MODE=true
APP_URL=https://mail.example.com
MAIL_HOSTNAME=mail.example.com

# Managed Mongo (Coolify). Root user needs authSource=admin.
# Local `docker compose` overrides this to mongodb://mongo:27017/mailflare.
MONGO_URL=mongodb://root:PASSWORD@HOST:27017/mailflare?directConnection=true&authSource=admin

S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=
S3_KEY_PREFIX=prod_mail
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

INBOUND_WEBHOOK_SECRET=
SMTP_INBOUND_PORT=25
SMTP_URL=smtp://postfix:587
SMTP_TLS_REJECT_UNAUTHORIZED=false

# Client IP used for login rate limiting. Off Cloudflare Workers the
# cf-connecting-ip header is client-controlled, so it is replaced with the TCP
# peer unless you name a header your proxy sets (e.g. cf-connecting-ip behind
# Cloudflare, x-real-ip behind nginx) or how many proxies append X-Forwarded-For.
# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
# TRUST_PROXY_HOPS=1

# Plain-TCP IMAP (port 143) refuses sign-in so passwords never cross the network
# unencrypted. Prefer IMAPS_PORT=993 with SMTP_TLS_KEY/SMTP_TLS_CERT. Only set
# this when TLS is terminated in front of port 143.
# IMAP_ALLOW_INSECURE_AUTH=true
