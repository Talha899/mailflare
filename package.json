{
  "name": "mailflare",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:node",
    "build": "npm run build:node",
    "build:next": "npm run db:bundle && MAILFLARE_RUNTIME=node next build",
    "start": "npm run start:node",
    "lint": "eslint .",
    "db:bundle": "node scripts/generate-migration-bundle.mjs",
    "db:generate": "drizzle-kit generate",
    "db:seed": "curl -X POST http://localhost:3000/api/seed",
    "build:node": "npm run db:bundle && MAILFLARE_RUNTIME=node next build && node scripts/build-server.mjs",
    "start:node": "MAILFLARE_RUNTIME=node NODE_ENV=production node dist/server.mjs",
    "dev:node": "npm run db:bundle && node scripts/build-server.mjs && MAILFLARE_RUNTIME=node node dist/server.mjs"
  },
