# Web (production example: https://mail.codenak.com)
APP_URL=http://localhost:3000

# SaaS multi-org mode (Docker/Node). Requires MONGO_URL.
SAAS_MODE=true
# Local compose: mongodb://mongo:27017/mailflare
# Coolify / managed Mongo root user: include authSource=admin and a database path, e.g.
# mongodb://root:PASSWORD@HOST:27017/mailflare?directConnection=true&authSource=admin
MONGO_URL=mongodb://mongo:27017/mailflare

# Receiving mail (production: mail.codenak.com)
MAIL_HOSTNAME=localhost
SMTP_INBOUND_PORT=25
SMTP_MAX_SIZE=37748736
SMTP_TLS_KEY=
SMTP_TLS_CERT=
INBOUND_WEBHOOK_SECRET=

# Sending mail — set SMTP_URL (any relay) and/or Cloudflare Email Sending
SMTP_URL=
SMTP_TLS_REJECT_UNAUTHORIZED=true
CF_ACCOUNT_ID=
CF_TOKEN=

# AI assistant (optional)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Object storage (optional S3-compatible API; default is local files under /data/blobs)
# S3_ENDPOINT=https://s3.codenak.com
# S3_REGION=us-east-1
# S3_BUCKET=healudoc
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_KEY_PREFIX=prod_mail
# STORAGE_* aliases also work: STORAGE_ENDPOINT, STORAGE_BUCKET, STORAGE_ACCESS_KEY_ID,
# STORAGE_SECRET_ACCESS_KEY, STORAGE_FOLDER (maps to S3_KEY_PREFIX).
